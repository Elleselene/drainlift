# Kopyahin ang file na ito bilang ".env" (sa parehong folder), tapos palitan ng totoong
# values galing sa Supabase dashboard mo: Project Settings -> API.
#
# HUWAG i-commit ang ".env" mismo sa GitHub (naka-ignore na ito sa .gitignore) — ang mga API
# key sa ibaba, lalo na ang SERVICE ROLE key, ay dapat lihim.

# --- Client-safe (ligtas ilantad sa browser; may VITE_ prefix para makita ng frontend) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Server-only (HUWAG ilagay ang VITE_ prefix — hindi ito dapat makita ng browser) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
